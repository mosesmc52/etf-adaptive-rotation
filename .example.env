# Copy to .env and replace the credential placeholders.
ALPACA_KEY_ID=your_alpaca_key_id
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER=true

# Execution: preview by default; rebalance once per month.
# LIVE submits through the configured endpoint; PAPER simulates; OBSERVE reports.
APP_STATE=OBSERVE
FORCED_REBALANCE=false
# Fraction of total account equity allocated to the strategy.
EQUITY_FRACTION=1.0
# Optional: unset uses .rotation-state-<account_id>.json beside helpers.py.
# STATE_PATH=/path/to/persistent/rotation-state.json

# ETF universe and historical data (lists are comma-separated).
ETF_UNIVERSE=QQQ,VXUS,TLT,GLD,VNQ
CASH_ETF=BIL
HISTORY_START=2007-01-01

# Selection, momentum, and trend.
TOP_N=2
EXIT_RANK=5
MOMENTUM_LOOKBACKS=63,126,252
MOMENTUM_WEIGHTS=0.50,0.30,0.20
TREND_MA=150
USE_EMA_SMOOTHING=true
EMA_ALPHA=0.30
USE_HYSTERESIS=true

# Volatility targeting and exposure.
VOL_LOOKBACK=20
TARGET_VOL=0.20
MAX_GROSS_EXPOSURE=1.50
USE_MOMENTUM_LEVERAGE_GATE=true
NORMAL_GROSS_CAP=1.00
LEVERAGE_MOMENTUM_LOOKBACKS=63,126,252
LEVERAGE_ON_REQUIRED_POSITIVE=3
LEVERAGE_OFF_MIN_POSITIVE=2
HIGH_VOL_ADJUSTMENT_ENABLED=true
HIGH_VOL_THRESHOLD=1.20
HIGH_VOL_WEIGHT_MULTIPLIER=0.70
HIGH_VOL_REFERENCE_LOOKBACK=252

# Optional SES email reporting.
EMAIL_POSITIONS=false
TO_ADDRESSES=recipient@example.com
FROM_ADDRESS=sender@example.com
AWS_SES_REGION_NAME=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_ses_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key

# Optional DigitalOcean Spaces JSON export.
SYNC_STRATEGY_JSON_TO_SPACES=false
SPACES_REGION=nyc3
SPACES_BUCKET=your_spaces_bucket
SPACES_OBJECT_KEY_PATH=
SPACES_KEY=your_spaces_access_key
SPACES_SECRET=your_spaces_secret_key
